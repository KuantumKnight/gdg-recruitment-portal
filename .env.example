# ==========================================
# 5. GOOGLE OAUTH PROVIDER (Required)
# ==========================================
# Only verified Google Workspace accounts ending in @vitstudent.ac.in are accepted.
# Add both local and production callback URLs in Google Cloud Console:
# http://localhost:3000/api/auth/callback/google
# https://your-domain.example/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxx-xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"

# ==========================================
# 6. ADMIN EMAIL BROADCAST (Optional)
# ==========================================
# Used only by the protected admin applicant-email workflow.
# For Gmail, use an app password rather than the account password.
EMAIL_USERNAME="your-email@gmail.com"
EMAIL_PASSWORD="your-gmail-app-password"

